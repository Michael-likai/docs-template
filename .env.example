# ---------------------------------------------------------------------------
# Site identity is edited in docs/.vitepress/site.config.ts.
# This file only holds secrets / per-environment values.
# ---------------------------------------------------------------------------

# Optional: Umami analytics (leave empty to disable).
# Using a same-origin host such as /s avoids ad blockers; see scripts/edgeone.mjs.
UMAMI_WEBSITE_ID=
UMAMI_HOST_URL=/s

# --- Cloudflare Pages -------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=folio-docs

# --- EdgeOne Makers ---------------------------------------------------------
EDGEONE_API_TOKEN=
EDGEONE_PROJECT=folio-docs
# EdgeOne CLI command, override when installed under another name/path.
# EDGEONE_CLI=edgeone

# --- Optional search-engine verification ------------------------------------
GOOGLE_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
